# ──────────────────────────────────────────────────────────────────────────────
# SciConBench — Environment Variables
# Copy this file to .env and fill in the values for the providers you use.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Note: OpenAI models are also used for generating atomic facts and LLM judge labeling
# for evaluation.

# Standard OpenAI API (leave OPENAI_BASE_URL and OPENAI_API_VERSION blank)
OPENAI_API_KEY=

# Azure OpenAI / Foundry (fill these instead of OPENAI_API_KEY when using Azure)
AZURE_OPENAI_KEY=
OPENAI_BASE_URL=
OPENAI_API_VERSION=2025-04-01-preview

# DeepSeek-V4-Pro (provider="azure") lives on its own Foundry resource — set
# these instead of / in addition to AZURE_OPENAI_KEY / OPENAI_BASE_URL above.
# Falls back to AZURE_OPENAI_KEY / OPENAI_BASE_URL if unset.
COCHRANE_DASHBOARD_OPENAI_KEY=
COCHRANE_DASHBOARD_BASE_URL=https://cochrane-dashboard.cognitiveservices.azure.com/

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Azure-hosted Anthropic (only needed if routing Claude through Azure)
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_BASE_URL=
AZURE_ANTHROPIC_RESOURCE_NAME=

# ── Google / Gemini ───────────────────────────────────────────────────────────

# Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=true and fill project/location)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=true

# ── Perplexity ────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=

# ── OpenRouter (provider="openrouter") ─────────────────────────────────────────
# Used for Kimi K3 (moonshotai/kimi-k3), GLM-5.2 (z-ai/glm-5.2),
# Qwen3.5-9B (qwen/qwen3.5-9b), Qwen3.7-max (qwen/qwen3.7-max),
# and any other OpenRouter-hosted model.
OPENROUTER_API_KEY=
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=       # for openrouter.ai leaderboard attribution
# OPENROUTER_SITE_NAME=

# ── SciConHarness web search and browsing tools (required for enable_tools=True) ────────────────────────
SERPER_API_KEY=
JINA_API_KEY=
S2_API_KEY=

# ── SerpAPI (alternative Google search backend, optional) ────────────────────
SERPAPI_API_KEY=

# ── Remote MCP server auth token (only needed for OpenAI's deep-research agents) ───────
MCP_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# SciConBench-Track — Longitudinal Pipeline
# ──────────────────────────────────────────────────────────────────────────────

# ── Wiley Text & Data Mining API (required for PDF downloads) ─────────────────
# Token from https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining
WILEY_TDM_TOKEN=

# ── Crossref polite pool (optional but recommended) ──────────────────────────
# Adding your email gets you into the Crossref polite pool (higher rate limits)
CROSSREF_MAILTO=

# ── HuggingFace (required for dataset upload) ────────────────────────────────
# Write token from https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Data directory override (optional) ───────────────────────────────────────
# Defaults to ./data_track/ relative to the repo root.  Set to use a different path.
# SCICON_DATA_DIR=/path/to/your/data_track

# ── sciconharness Cochrane-filter cache override (optional) ──────────────────
# Local JSON cache of the HF benchmark's titles / doi->title / doi->publication_date
# (see sciconharness/utils/hf_benchmark_cache.py). Defaults to
# ./data_track/hf_benchmark_cache/ relative to the repo root; only read here if
# HF_TOKEN above is unset or the dataset is public (a read-only token is fine).
# SCICONBENCH_CACHE_DIR=/path/to/your/hf_benchmark_cache

# ── Email notifications (optional — pipeline continues if absent) ─────────────
EMAIL_SENDER=
EMAIL_APP_PASSWORD=        # Gmail App Password (not your account password)
EMAIL_RECIPIENT=
