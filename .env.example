# ──────────────────────────────────────────────────────────────────────────────
# SciConBench — Environment Variables
# Copy this file to .env and fill in the values for the providers you use.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Note: OpenAI models are also used for generating atomic facts and LLM judge labeling
# for evaluation.

# Standard OpenAI API (leave OPENAI_BASE_URL and OPENAI_API_VERSION blank)
OPENAI_API_KEY=

# Azure OpenAI (fill these instead of OPENAI_API_KEY when using Azure)
AZURE_OPENAI_KEY=
OPENAI_BASE_URL=
OPENAI_API_VERSION=2025-04-01-preview

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Azure-hosted Anthropic (only needed if routing Claude through Azure)
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_BASE_URL=
AZURE_ANTHROPIC_RESOURCE_NAME=

# ── Google / Gemini ───────────────────────────────────────────────────────────

# Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=true and fill project/location)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=true

# ── Perplexity ────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=

# ── SciConHarness web search and browsing tools (required for enable_tools=True) ────────────────────────
SERPER_API_KEY=
JINA_API_KEY=
S2_API_KEY=

# ── SerpAPI (alternative Google search backend, optional) ────────────────────
SERPAPI_API_KEY=

# ── Remote MCP server auth token (only needed for OpenAI's deep-research agents) ───────
MCP_AUTH_TOKEN=
