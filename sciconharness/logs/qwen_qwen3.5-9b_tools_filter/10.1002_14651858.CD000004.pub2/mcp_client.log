      "paper": {
        "corpusId": "269110898",
        "title": "Incidence of stillbirth and perinatal mortality and their associated factors among women delivering at Harare Maternity Hospital, Zimbabwe: a cross-sectional retrospective analysis",
        "authors": [
          "S. Feresu",
          "S. Harlow",
          "K. Welch",
