      "paper": {
        "corpusId": "7807029",
        "title": "Rethinking IUGR in preeclampsia: dependent or independent of maternal hypertension?",
        "authors": [
          "S. Srinivas",
          "Andrea G. Edlow",
          "P. Neff",
          "M. Sammel",
