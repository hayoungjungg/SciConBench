        "corpusId": "70593427",
        "title": "Hypertension in Pregnancy: The Use of Ultrasound",
        "authors": [
          "J. Hobbins",
          "R. Berkowitz"
        ],
        "openAccessInfo": {
          "license": null,
          "status": "CLOSED",
          "disclaimer": "Notice: This snippet is extracted from the open access paper or abstract available at https://pmc.ncbi.nlm.nih.gov/articles/PMC2595516, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for your use."
        }
