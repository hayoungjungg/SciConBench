        "corpusId": "17585543",
        "title": "17-Hydroxyprogesterone caproate to prolong pregnancy after preterm rupture of the membranes: early termination of a double-blind, randomized clinical trial",
        "authors": [
          "C. Combs",
          "T. Garite",
          "K. Maurel",
          "Kimberly Mallory",
          "R. Edwards",
          "G. Lu",
